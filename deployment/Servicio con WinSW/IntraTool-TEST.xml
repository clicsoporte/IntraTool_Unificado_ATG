<service>
  <id>IntraTool_Unificado_TEST</id>
  <name>IntraTool Unificado (PRUEBAS)</name>
  <description>Servidor Web de IntraTool Unificado en Modo Pruebas/Desarrollo en Node.js / Next.js (Puerto HTTP 9004)</description>

  <!-- Ejecutable y Argumentos -->
  <executable>npm.cmd</executable>
  <arguments>run dev</arguments>

  <!-- Directorio de trabajo: Raíz del proyecto -->
  <workingdirectory>%BASE%\..\..</workingdirectory>

  <!-- Variables de Entorno -->
  <env name="PORT" value="9004" />
  <env name="NODE_ENV" value="development" />

  <!-- Configuración de Logs (Archivos rotativos de 10 MB) -->
  <logpath>%BASE%\..\..\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <!-- Política de Reinicio Automático por Fallos -->
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 day</resetfailure>
</service>
